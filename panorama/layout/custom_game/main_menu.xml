<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/main_menu.css" />
	</styles>

	<Panel class="Root">
	<Panel class="MenuRoot" id="main_menu_root">
		<Panel class="Window">
			<Panel class="TitleBar">
				<Panel class="TitleAccent" />
				<Panel class="TitleBlock">
					<Label class="Eyebrow" text="MATCH SETUP" />
					<Label class="Title" text="CS2 BUT DAMAGE THROWS NADES" />
				</Panel>
				<Label class="Credit" text="Map by Bambi p&#229; hal is" />
			</Panel>

			<Panel id="tab_bar" class="TabBar">
				<Button id="tab_map" class="TabButton Active">
					<Label text="MAP" />
				</Button>
				<Button id="tab_teams" class="TabButton">
					<Label text="TEAMS" />
				</Button>
				<Button id="tab_rules" class="TabButton">
					<Label text="RULES" />
				</Button>
				<Button id="tab_bots" class="TabButton">
					<Label text="BOT SUPPORT (EXPERIMENTAL)" />
				</Button>
				<Button id="tab_starting" class="TabButton Hidden">
					<Label text="STARTING" />
				</Button>
			</Panel>

			<Panel id="panel_map" class="TabPanel">
				<Panel class="MapGrid">
					<Button id="map_de_ancient" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_ancient.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Ancient" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_ancient_night" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_ancient_night.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Ancient Night" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_anubis" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_anubis.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Anubis" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_cache" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_cache.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Cache" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_dust2" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_dust2.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Dust2" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_inferno" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_inferno.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Inferno" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_cs_italy" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/cs_italy.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Italy" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_mirage" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_mirage.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Mirage" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_nuke" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_nuke.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Nuke" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_cs_office" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/cs_office.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Office" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_overpass" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_overpass.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Overpass" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_train" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_train.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Train" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
					<Button id="map_de_vertigo" class="MapCard">
						<Image class="MapThumb" src="file://{resources}/styles/custom_game/de_vertigo.jpg" />
						<Panel class="MapCardFooter"><Panel class="MapCardText"><Label class="MapName" text="Vertigo" /><Label class="MapVotes" text="{s:votes}" /></Panel></Panel>
					</Button>
				</Panel>
			</Panel>


			<Panel id="panel_teams" class="TabPanel Hidden">
				<Panel class="TeamColumn CT">
					<Panel class="TeamHeader">
						<Panel class="TeamHeaderDot" />
						<Label class="TeamHeaderLabel" text="COUNTER-TERRORISTS" />
					</Panel>
					<Panel class="SlotList">
						<Panel id="ct_slot_0" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="1" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_0" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_1" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="2" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_1" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_2" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="3" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_2" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_3" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="4" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_3" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_4" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="5" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_4" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_5" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="6" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_5" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_6" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="7" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_6" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_7" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="8" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_7" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_8" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="9" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_8" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
						<Panel id="ct_slot_9" class="PlayerSlot Empty"><Panel class="SlotIndex"><Label text="10" /></Panel><Label class="PlayerName" text="{s:name}" /><Button id="team_slot_ct_9" class="MoveButton"><Label text="&#8594;" /></Button></Panel>
					</Panel>
				</Panel>
				<Panel class="TeamColumn T">
					<Panel class="TeamHeader">
						<Panel class="TeamHeaderDot" />
						<Label class="TeamHeaderLabel" text="TERRORISTS" />
					</Panel>
					<Panel class="SlotList">
						<Panel id="t_slot_0" class="PlayerSlot Empty"><Button id="team_slot_t_0" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="1" /></Panel></Panel>
						<Panel id="t_slot_1" class="PlayerSlot Empty"><Button id="team_slot_t_1" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="2" /></Panel></Panel>
						<Panel id="t_slot_2" class="PlayerSlot Empty"><Button id="team_slot_t_2" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="3" /></Panel></Panel>
						<Panel id="t_slot_3" class="PlayerSlot Empty"><Button id="team_slot_t_3" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="4" /></Panel></Panel>
						<Panel id="t_slot_4" class="PlayerSlot Empty"><Button id="team_slot_t_4" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="5" /></Panel></Panel>
						<Panel id="t_slot_5" class="PlayerSlot Empty"><Button id="team_slot_t_5" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="6" /></Panel></Panel>
						<Panel id="t_slot_6" class="PlayerSlot Empty"><Button id="team_slot_t_6" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="7" /></Panel></Panel>
						<Panel id="t_slot_7" class="PlayerSlot Empty"><Button id="team_slot_t_7" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="8" /></Panel></Panel>
						<Panel id="t_slot_8" class="PlayerSlot Empty"><Button id="team_slot_t_8" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="9" /></Panel></Panel>
						<Panel id="t_slot_9" class="PlayerSlot Empty"><Button id="team_slot_t_9" class="MoveButton"><Label text="&#8592;" /></Button><Label class="PlayerName" text="{s:name}" /><Panel class="SlotIndex"><Label text="10" /></Panel></Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="panel_rules" class="TabPanel Hidden">
				<Panel class="RulesColumn">
					<Label class="SectionEyebrow" text="TRIGGER RULES" />
					<Panel class="RuleGroup">
						<Panel class="RuleRow Paired">
							<Label class="RuleLabel" text="Throw a nade when shooting" />
							<Button id="rule_toggle_throw_on_shoot" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
						<Panel class="RuleRow Paired Last">
							<Label class="RuleLabel" text="Chance to throw when shooting" />
							<Panel class="Stepper">
								<Button id="rule_shoot_chance_dec" class="StepButton StepButtonMinus"><Label text="&#8722;" /></Button>
								<Panel id="rule_shoot_chance_value" class="StepValue"><Label text="{s:value}" /></Panel>
								<Button id="rule_shoot_chance_inc" class="StepButton"><Label text="+" /></Button>
							</Panel>
						</Panel>
					</Panel>
					<Panel class="RuleGroup">
						<Panel class="RuleRow Paired">
							<Label class="RuleLabel" text="Throw a nade when dealing damage" />
							<Button id="rule_toggle_throw_on_damage" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
						<Panel class="RuleRow Paired Last">
							<Label class="RuleLabel" text="Chance to throw when dealing damage" />
							<Panel class="Stepper">
								<Button id="rule_damage_chance_dec" class="StepButton StepButtonMinus"><Label text="&#8722;" /></Button>
								<Panel id="rule_damage_chance_value" class="StepValue"><Label text="{s:value}" /></Panel>
								<Button id="rule_damage_chance_inc" class="StepButton"><Label text="+" /></Button>
							</Panel>
						</Panel>
					</Panel>
					<Label class="SectionEyebrow Stacked" text="MATCH SETTINGS" />
					<Panel class="RuleSolo">
						<Panel class="RuleRow Paired Last">
							<Label class="RuleLabel" text="Player health" />
							<Panel class="Stepper">
								<Button id="rule_health_dec" class="StepButton StepButtonMinus"><Label text="&#8722;" /></Button>
								<Panel id="rule_health_value" class="StepValue"><Label text="{s:value}" /></Panel>
								<Button id="rule_health_inc" class="StepButton"><Label text="+" /></Button>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
				<Panel class="RulesColumn Last">
					<Label class="SectionEyebrow" text="GRENADE TYPES" />
					<Panel class="RuleGroup">
						<Panel class="RuleRow Paired">
							<Label class="RuleLabel" text="Allow HE" />
							<Button id="rule_toggle_he" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
						<Panel class="RuleRow Paired">
							<Label class="RuleLabel" text="Allow Flashbang" />
							<Button id="rule_toggle_flashbang" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
						<Panel class="RuleRow Paired">
							<Label class="RuleLabel" text="Allow Smoke" />
							<Button id="rule_toggle_smoke" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
						<Panel class="RuleRow Paired">
							<Label class="RuleLabel" text="Allow Molotov / Incendiary" />
							<Button id="rule_toggle_molotov" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
						<Panel class="RuleRow Paired Last">
							<Label class="RuleLabel" text="Allow Decoy" />
							<Button id="rule_toggle_decoy" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
					</Panel>
					<Label class="SectionEyebrow Stacked" text="OTHER" />
					<Panel class="RuleSolo">
						<Panel class="RuleRow Paired Last">
							<Label class="RuleLabel" text="Only random between allowed grenades the player is carrying" />
							<Button id="rule_toggle_only_equipped" class="Checkbox"><Label class="CheckMark" text="&#10003;" /></Button>
						</Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="panel_bots" class="TabPanel Hidden">
				<Panel class="RulesColumn">
					<Label class="SectionEyebrow" text="PLAYING WITH BOTS" />
					<Label class="BotText" text="Bots don't work in this lobby. Start your map from the console instead:" />
					<Label class="BotStep" text="1.  Open the console" />
					<Label class="BotStep" text="2.  Type the command for your map" />
					<Label class="BotStep" text="3.  Press Enter and add bots as usual" />
					<Label class="BotNote" text="No console? Settings &gt; Game &gt; Enable Developer Console." />
					<Label class="BotNote" text="The command is also on the Workshop page." />
				</Panel>
				<Panel class="RulesColumn Last">
					<Label class="SectionEyebrow" text="TYPE THIS IN THE CONSOLE" />
					<Panel class="BotMapList">
						<Panel class="BotMapRow"><Label class="BotMapName" text="Ancient" /><Label class="BotCommand" text="changelevel de_ancient customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Ancient Night" /><Label class="BotCommand" text="changelevel de_ancient_night customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Anubis" /><Label class="BotCommand" text="changelevel de_anubis customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Cache" /><Label class="BotCommand" text="changelevel de_cache customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Dust2" /><Label class="BotCommand" text="changelevel de_dust2 customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Inferno" /><Label class="BotCommand" text="changelevel de_inferno customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Italy" /><Label class="BotCommand" text="changelevel cs_italy customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Mirage" /><Label class="BotCommand" text="changelevel de_mirage customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Nuke" /><Label class="BotCommand" text="changelevel de_nuke customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Office" /><Label class="BotCommand" text="changelevel cs_office customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Overpass" /><Label class="BotCommand" text="changelevel de_overpass customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Train" /><Label class="BotCommand" text="changelevel de_train customgamemode=3595406215" /></Panel>
						<Panel class="BotMapRow"><Label class="BotMapName" text="Vertigo" /><Label class="BotCommand" text="changelevel de_vertigo customgamemode=3595406215" /></Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="panel_starting" class="TabPanel CountdownPanel Hidden">
				<Panel class="CountdownContent">
					<Label class="CountdownCaption" text="Match starting in..." />
					<Panel id="countdown_value" class="CountdownNumber"><Label text="{s:value}" /></Panel>
				</Panel>
			</Panel>

			<Panel id="footer_bar" class="FooterBar">
				<Label id="footer_hint" class="FooterHint" text="{s:hint}" />
				<Panel class="StartArea">
					<Panel id="start_spinner" class="Spinner Hidden">
						<Panel class="SpinnerRing" />
						<Label class="SpinnerLabel" text="STARTING..." />
					</Panel>
					<Button id="start_game_button" class="StartButton">
						<Label class="StartLabel" text="{s:label}" />
					</Button>
				</Panel>
			</Panel>
		</Panel>
	</Panel>

	<Panel id="rtv_hint" class="RtvHint Hidden">
		<Label id="rtv_hint_text" class="RtvHintText" text="{s:text}" />
	</Panel>
	</Panel>
</root>
